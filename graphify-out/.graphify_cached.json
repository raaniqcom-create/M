{"nodes": [{"id": "_github_workflows_android_build_apk", "label": "Build APK Workflow", "file_type": "code", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\android.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_android_capacitor_webview_shell", "label": "Capacitor WebView Shell (Android)", "file_type": "rationale", "rationale": "Replaced the Trusted Web Activity build: a TWA renders through Chrome, so on a phone whose browser does not support it Android asks the user to pick a browser, which is not an app experience. A WebView never does that, and site updates still reach users instantly because the shell only loads the URL.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\android.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_android_firebase_config_restore", "label": "Firebase Config Restore Step", "file_type": "rationale", "rationale": "google-services.json is kept out of the public repo, so it is base64-restored from a secret before the Gradle plugin looks for it; without it the app builds fine but never receives a device token.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\android.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_android_apk_signature_verification", "label": "APK Signature Verification", "file_type": "rationale", "rationale": "Android refuses to install an unsigned package, so apksigner proves the artifact is signed inside CI rather than the failure being discovered on a user's phone.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\android.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_android_aab_bundle", "label": "AAB Bundle Artifact", "file_type": "rationale", "rationale": "Google Play accepts only the bundle format for new apps, so the build produces muhta.aab alongside the sideloadable muhta.apk.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\android.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_deploy_deploy_site", "label": "Deploy Site Workflow", "file_type": "code", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\deploy.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_deploy_static_export_to_github_pages", "label": "Static Export to GitHub Pages", "file_type": "rationale", "rationale": "Free, unlimited deploys and reachable from Iraq. Everything dynamic runs in Supabase, so the site itself is just files.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\deploy.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_deploy_stations_changed_dispatch", "label": "stations-changed Repository Dispatch", "file_type": "rationale", "rationale": "Station approvals fire a repository_dispatch so a newly approved station gets its own statically generated page without a manual redeploy.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\deploy.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_deploy_nojekyll_guard", "label": ".nojekyll Guard", "file_type": "rationale", "rationale": "Without touching out/.nojekyll, GitHub Pages runs Jekyll and drops every _next/* asset.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\deploy.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_build_ios", "label": "Build iOS Workflow", "file_type": "code", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_wkwebview_shell", "label": "WKWebView Shell (iOS)", "file_type": "rationale", "rationale": "Same idea as the Android build: a shell around muhta.online. Apple requires macOS to compile and sign, and GitHub's macOS runners are free for public repositories, so no Mac is needed anywhere in the project.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_app_store_connect_api_key_signing", "label": "App Store Connect API Key Signing", "file_type": "rationale", "rationale": "Signing uses an App Store Connect API key rather than a checked-in certificate; -allowProvisioningUpdates lets Xcode create the distribution certificate and provisioning profile on the runner, so there is no .p12 to store, rotate, or leak. The decoded key is PEM-checked because a truncated secret produces a confusing signing failure much later.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_newest_xcode_selection", "label": "Newest Xcode Selection", "file_type": "rationale", "rationale": "App Store Connect rejects anything built with an older SDK and the runner image's default Xcode is not always its newest, so the job picks the highest installed rather than pinning a version that ages out of the image; an SDK older than iOS 26 fails the build early.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_run_number_build_number", "label": "Run Number as CFBundleVersion", "file_type": "rationale", "rationale": "Every upload needs a build number higher than the last one App Store Connect saw; the GitHub run number is monotonic and needs no bookkeeping.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_testflight_upload", "label": "TestFlight Upload Step", "file_type": "code", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\.github\\workflows\\ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_muhta_pwa", "label": "المحطة التقنية PWA", "file_type": "document", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tech_stack", "label": "Tech Stack (Next.js 16, Supabase, Leaflet, Web Push)", "file_type": "concept", "rationale": "Leaflet plus OpenStreetMap is chosen so the map needs no paid keys; the service worker is hand-written for offline use and notifications.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_roles", "label": "Three Roles: Driver, Station Owner, Admin", "file_type": "concept", "rationale": "Drivers browse, filter, vote and subscribe with no account at all; owners manage their station at /owner; admins approve or reject stations at /admin. A station is invisible to users until admin approval.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_database_schema", "label": "Database Schema (profiles, stations, station_products, traffic_votes, push_subscriptions, ads)", "file_type": "concept", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_station_traffic_avg", "label": "station_traffic_avg View", "file_type": "concept", "rationale": "Computes the 30-minute rolling congestion average at read time rather than storing it; one vote per station per device per 30 minutes, and an owner's own setting overrides the user average.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_color_only_voting", "label": "Colour-Only Congestion Voting", "file_type": "rationale", "rationale": "Votes are green/amber/red only, never free text, and this is enforced at the database level rather than only in the UI so no comment thread can ever appear.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_env_vars", "label": "Environment Variables and VAPID Keys", "file_type": "concept", "rationale": "The anon key is safe to expose because RLS protects it; the service role key is server-only and used for sending notifications.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_service_guide", "label": "Service Guide (Four-Page Attachment)", "file_type": "document", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_problem_statement", "label": "Problem Statement Table", "file_type": "concept", "rationale": "Four causes and their consequences: citizens learn availability only by asking or trying, information spreads verbally and through social groups, congestion is unevenly distributed, and calls flood the directorate and stations daily over something published information would settle.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_three_step_flow", "label": "Three-Step Operating Flow", "file_type": "concept", "rationale": "The station registers once, its supervisor toggles availability from an ordinary phone with no software, hardware or training, and the citizen sees the state immediately sorted by proximity with a one-tap route via Google Maps or Waze.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_admin_approval_gate", "label": "Admin Approval and Phone Verification Gate", "file_type": "rationale", "rationale": "No station is published without review by platform administration and a phone confirmation of its owner, so nobody can register a station that is not theirs or publish data under an existing station's name.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_privacy_stance", "label": "Data and Privacy Stance", "file_type": "rationale", "rationale": "No account, name or phone number is asked of a citizen to browse; no personal data is gathered and no movement tracked, with location used on the citizen's own device only to sort by proximity. What is published is station data as a service facility, all of it declared willingly by the owner.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_directorate_benefits", "label": "Benefits Offered to the Directorate", "file_type": "concept", "rationale": "A digital extension of the daily distribution tables, self-distributing congestion relief, fewer inbound calls, a live field picture showing which stations announced availability and when each last updated, an indicator of supply regularity per city, and no cost or financial commitment on the directorate.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_expansion_plan", "label": "Four-Phase Expansion Plan", "file_type": "concept", "rationale": "Phase one Ramadi (in progress), phase two Fallujah, Hit, Habbaniyah, Khalidiyah, Amiriyat al-Fallujah and Karma, phase three the remaining western cities, phase four a monitoring dashboard and periodic reports on availability regularity per city.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_faq", "label": "Anticipated Questions Box", "file_type": "concept", "rationale": "Liability rests with the station owner who enters the data, shown with a last-updated timestamp; a per-station report button reaches administration and a repeatedly inaccurate station can be delisted; no special hardware or internet is needed; and there are no fees on stations or citizens.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_letter_aldeera_aldeera_channel_letter", "label": "Letter to Al-Deera Satellite Channel", "file_type": "document", "rationale": "Thanks the channel as the first outlet to introduce the platform to the province and asks it to finish what it started, because the message that still has to reach station owners themselves is the one the team cannot deliver alone.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\letter-aldeera.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_letter_aldeera_two_requests", "label": "Two Requests to the Channel", "file_type": "concept", "rationale": "Announce the app launch once both stores finish publishing, and invite station owners across the province to register free of charge; supporting material in text, images or video is offered in whatever form and timing suits the channel.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\letter-aldeera.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_letter_official_letter", "label": "Official Letter to Anbar Oil Products Distribution", "file_type": "document", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\letter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_letter_three_requests", "label": "Three Requests to the Directorate", "file_type": "concept", "rationale": "Adopt the service as a supporting electronic channel alongside the daily distribution tables, circulate a directive to public and private stations to register and keep availability current (accuracy of the service follows from the accuracy of what stations enter), and name a liaison officer with a monitoring dashboard placed at the directorate's disposal.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\letter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_letter_qr_block", "label": "Service QR Block (Site, iPhone, Android)", "file_type": "concept", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\letter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_letter_ahmed_alrifai", "label": "أحمد الرفاعي — Platform Originator and Supervisor", "file_type": "concept", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\letter.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_promo_explainer_explainer_video", "label": "Explainer Video Stage (explainer.html)", "file_type": "document", "rationale": "Screen-recorded rather than exported from an editor: a fixed 1920x1080 stage scaled to fill the window, with all timing expressed as animation-delay on one shared timeline, so changing a scene means changing two numbers. R restarts, F fullscreens, space pauses.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\promo\\explainer.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_promo_explainer_dual_aspect_one_file", "label": "Two Aspect Ratios From One File", "file_type": "rationale", "rationale": "The wide cut for the channel and Facebook and the vertical cut for stories come from the same document via ?v=story or the V key, because two separate files would diverge at the first edit.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\promo\\explainer.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_promo_explainer_scene_sequence", "label": "Nine-Scene Explainer Sequence", "file_type": "concept", "rationale": "The daily question, the cost of the late answer (an hour, a litre, a stale post), the information already existing with the station owner but having no road to the people, one tap building that road, delivery to whoever chose their city and fuel, wholly free, an invitation addressed to both owner and user, the name and slogan, and the QR codes filmed straight off the screen.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\promo\\explainer.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_promo_explainer_qr_legibility", "label": "QR Legibility Under Video Compression", "file_type": "rationale", "rationale": "Codes are drawn at 340px inside a 1920 frame so the densest 53-module code still lands about 3.4 pixels per module when watched at 1080 wide on a phone; 270px would drop it to 2.5 and make it a gamble on video compression. The code itself is inked rather than green because green on white is about 3.9:1 contrast, enough on paper but not necessarily after compression and broadcast colour shift.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\promo\\explainer.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_promo_explainer_persistent_brand_mark", "label": "Persistent Brand Band", "file_type": "rationale", "rationale": "Scenes end at the edge of the bottom band rather than running under it: making the mark opaque above the content hid the overlap instead of preventing it, and a phone edge disappearing behind a card reads as a design mistake. The band is part of the layout and each scene centres in what is left above it.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\promo\\explainer.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_promo_guide_station_owner_guide_video", "label": "Station Owner Guide Video (guide.html)", "file_type": "document", "rationale": "Nine steps at about eight seconds each with no voiceover, because the pacing is measured for reading rather than listening: one step on screen, one sentence, and a picture of exactly what the owner will see when he opens his phone. It reuses the same stage as explainer.html so the same capture script renders it to MP4 in both sizes.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\promo\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_promo_guide_step_sequence", "label": "Owner Guide Step Sequence", "file_type": "concept", "rationale": "Title, signing in, phone number and password, the «لوحة محطتي» dashboard, the products panel, confirming availability, congestion, the daily update habit, the shareable availability image carrying station name, available products and date, the station link, and the closing card.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\promo\\guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ios_app_capapp_spm_readme_capapp_spm", "label": "CapApp-SPM Dependency Host Package", "file_type": "document", "rationale": "Generated package that hosts SPM dependencies for the Capacitor project; explicitly not to be modified by hand.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\ios\\App\\CapApp-SPM\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_listing", "label": "Google Play Store Listing Copy", "file_type": "document", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\store\\google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_app_name", "label": "App Name Without the Province", "file_type": "rationale", "rationale": "The name omits «الأنبار» because the name is fixed in the user's mind while expansion to the rest of Iraq cannot carry a name that confines the platform to one province; Anbar stays in the description, which can be edited any time.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\store\\google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_package_name", "label": "Package Name online.muhta.app", "file_type": "concept", "rationale": "Immutable after creation and must match the AAB file, the Firebase project and assetlinks.json.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\store\\google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_data_safety", "label": "Play Data Safety Declaration", "file_type": "concept", "rationale": "Approximate location is declared as not collected because it is used on-device only to sort stations and never sent to the server; name and phone are collected for station owners only, congestion colour votes count as user-generated content, and the notification identifier as a device ID.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\store\\google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_content_rating", "label": "Play Content Rating Answers", "file_type": "concept", "rationale": "Colour voting is declared as not user interaction, so the expected rating is Everyone / 3+.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\store\\google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_app_access_review_account", "label": "Reviewer Demo Station Account", "file_type": "rationale", "rationale": "The reviewer needs an account to see the station-owner dashboard, otherwise only the public interface is visible; the demo account must exist before submission or the app is rejected.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\store\\google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_closed_testing_requirement", "label": "12-Tester Closed Testing Requirement", "file_type": "concept", "rationale": "Individual developer accounts created after November 2023 must run closed testing with 12 testers for 14 days before public release; company accounts and older accounts are exempt.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\store\\google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_screenshots", "label": "Six Ordered Play Screenshots", "file_type": "concept", "rationale": "Play shows screenshots in upload order, so the sequence is fixed; the mocked interface shots are to be replaced with real phone captures once actual stations are registered, because a real capture is truer and less open to objection.", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\store\\google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_pdf_export", "label": "Service Guide PDF Export", "file_type": "document", "source_file": "C:\\Users\\al3r1\\OneDrive\\Desktop\\muhta\\docs\\anbar-oil\\guide.