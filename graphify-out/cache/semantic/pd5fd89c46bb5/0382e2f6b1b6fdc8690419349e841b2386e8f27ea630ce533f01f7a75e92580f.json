{"nodes": [{"id": "docs_anbar_oil_data_governance_document", "label": "\u0648\u062b\u064a\u0642\u0629 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u2014 \u0627\u0644\u0645\u062d\u0637\u0629 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 (\u0668 \u0623\u064a\u0644\u0648\u0644 \u0662\u0660\u0662\u0666)", "file_type": "document", "source_file": "docs/anbar-oil/data-governance.html", "source_location": null, "source_url": "muhta.online", "captured_at": "\u0668 \u0623\u064a\u0644\u0648\u0644 \u0662\u0660\u0662\u0666", "author": null, "contributor": null, "rationale": "\u0628\u064f\u0646\u064a\u062a \u0627\u0644\u0648\u062b\u064a\u0642\u0629 \u062d\u0648\u0644 \u0623\u0631\u0628\u0639\u0629 \u0623\u0633\u0626\u0644\u0629 \u0635\u0631\u064a\u062d\u0629 \u2014 \u0645\u0627\u0630\u0627 \u064a\u064f\u062c\u0645\u0639\u060c \u0623\u064a\u0646 \u064a\u064f\u062e\u0632\u064e\u0651\u0646\u060c \u0645\u0646 \u064a\u0631\u0627\u0647\u060c \u0645\u062a\u0649 \u064a\u064f\u0645\u062d\u0649 \u2014 \u0644\u062a\u0643\u0648\u0646 \u062c\u0648\u0627\u0628\u0627\u064b \u0642\u0627\u0628\u0644\u0627\u064b \u0644\u0644\u062a\u062f\u0642\u064a\u0642 \u0644\u0627 \u0628\u064a\u0627\u0646\u0627\u064b \u062a\u0633\u0648\u064a\u0642\u064a\u0627\u064b."}, {"id": "docs_anbar_oil_data_governance_no_citizen_account", "label": "\u0627\u0644\u0645\u0648\u0627\u0637\u0646 \u0644\u0627 \u064a\u064f\u0633\u062c\u064e\u0651\u0644 \u2014 \u0644\u0627 \u062d\u0633\u0627\u0628 \u0648\u0644\u0627 \u0627\u0633\u0645 \u0648\u0644\u0627 \u0647\u0627\u062a\u0641", "file_type": "rationale", "source_file": "docs/anbar-oil/data-governance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0623\u0642\u0644\u0651 \u0645\u0627 \u064a\u064f\u062c\u0645\u0639 \u0647\u0648 \u0623\u0642\u0644\u0651 \u0645\u0627 \u064a\u064f\u0633\u0631\u064e\u0651\u0628: \u0641\u062a\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u0627 \u064a\u0646\u0634\u0626 \u062d\u0633\u0627\u0628\u0627\u064b\u060c \u0648\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u064f\u062c\u0645\u0639 \u0623\u0635\u0644\u0627\u064b \u0644\u0627 \u062a\u062d\u062a\u0627\u062c \u062d\u0645\u0627\u064a\u0629 \u0648\u0644\u0627 \u0645\u062d\u0648\u0627\u064b."}, {"id": "docs_anbar_oil_data_governance_push_token", "label": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 (\u0631\u0645\u0632 \u0627\u0644\u062c\u0647\u0627\u0632 \u0623\u0648 \u0639\u0646\u0648\u0627\u0646 \u062f\u0641\u0639 \u0627\u0644\u0645\u062a\u0635\u0641\u0651\u062d)", "file_type": "concept", "source_file": "docs/anbar-oil/data-governance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0631\u0645\u0632 \u064a\u0635\u062f\u0631\u0647 \u0627\u0644\u0645\u062a\u0635\u0641\u0651\u062d \u0623\u0648 \u0646\u0638\u0627\u0645 \u0627\u0644\u0647\u0627\u062a\u0641\u060c \u0644\u0627 \u064a\u062f\u0644\u0651 \u0639\u0644\u0649 \u0634\u062e\u0635 \u0648\u0644\u0627 \u064a\u0635\u0644\u062d \u0644\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0647 \u2014 \u0641\u0627\u062e\u062a\u064a\u0631 \u0628\u062f\u064a\u0644\u0627\u064b \u0639\u0646 \u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641 \u0644\u0625\u064a\u0635\u0627\u0644 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u0628\u0644\u0627 \u0645\u0639\u0631\u0651\u0641 \u0634\u062e\u0635\u064a. \u064a\u0628\u0642\u0649 \u062d\u062a\u0649 \u064a\u064f\u0644\u063a\u064a \u0635\u0627\u062d\u0628\u0647 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0623\u0648 \u064a\u062d\u0630\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642."}, {"id": "docs_anbar_oil_data_governance_collected_data_table", "label": "\u062c\u062f\u0648\u0644 \u00ab\u0645\u0627 \u064a\u064f\u062c\u0645\u0639\u060c \u0648\u0644\u0645\u0627\u0630\u0627\u00bb \u2014 \u0627\u0644\u0628\u064a\u0627\u0646\u060c \u0627\u0644\u063a\u0631\u0636\u060c \u0645\u0646 \u064a\u0631\u0627\u0647\u060c \u0645\u062f\u0629 \u0627\u0644\u0628\u0642\u0627\u0621", "file_type": "document", "source_file": "docs/anbar-oil/data-governance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u062d\u0635\u0631 \u0645\u063a\u0644\u0642: \u0644\u0627 \u0645\u0648\u0642\u0639 \u062c\u063a\u0631\u0627\u0641\u064a\u0651 \u064a\u064f\u062e\u0632\u064e\u0651\u0646 (\u064a\u064f\u0633\u062a\u0639\u0645\u0644 \u0641\u064a \u0627\u0644\u062c\u0647\u0627\u0632 \u0644\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0645\u062d\u0637\u0627\u062a \u0628\u0627\u0644\u0642\u0631\u0628 \u062b\u0645\u0651 \u064a\u064f\u0646\u0633\u0649)\u060c \u0648\u0644\u0627 \u0633\u062c\u0644\u0651 \u062a\u0635\u0641\u0651\u062d\u060c \u0648\u0644\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u062f\u0641\u0639 \u2014 \u0641\u0644\u0627 \u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0646\u0635\u0651\u0629 \u0623\u0635\u0644\u0627\u064b."}, {"id": "docs_anbar_oil_data_governance_supabase_postgres", "label": "PostgreSQL 17 \u0639\u0644\u0649 Supabase \u2014 \u0645\u0631\u0643\u0632 \u0628\u064a\u0627\u0646\u0627\u062a ap-southeast-1 (\u0633\u0646\u063a\u0627\u0641\u0648\u0631\u0629)\u060c \u0627\u062a\u0635\u0627\u0644 TLS", "file_type": "concept", "source_file": "docs/anbar-oil/data-governance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_data_governance_row_level_security", "label": "\u0633\u064a\u0627\u0633\u0627\u062a \u0623\u0645\u0627\u0646 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0635\u0641\u0651 (RLS) \u2014 \u0627\u0644\u0645\u0646\u0639 \u0641\u064a \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0644\u0627 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642", "file_type": "rationale", "source_file": "docs/anbar-oil/data-governance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0648\u064f\u0636\u0639 \u0627\u0644\u062d\u062c\u0628 \u062f\u0627\u062e\u0644 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0646\u0641\u0633\u0647\u0627 \u0644\u0623\u0646 \u0645\u0627 \u064a\u064f\u0645\u0646\u0639 \u0641\u064a \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u064a\u064f\u0644\u062a\u064e\u0641\u0651 \u0639\u0644\u064a\u0647 \u0628\u062a\u063a\u064a\u064a\u0631 \u0648\u0627\u062c\u0647\u0629\u061b \u0639\u0646\u0627\u0648\u064a\u0646 \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0648\u062c\u062f\u0627\u0648\u0644\u0647\u0627 \u0645\u0645\u0646\u0648\u0639\u0629 \u0639\u0646 \u0643\u0644\u0651 \u0645\u0641\u062a\u0627\u062d \u0639\u0627\u0645\u0651 \u0648\u0644\u0627 \u062a\u064f\u0642\u0631\u0623 \u0625\u0644\u0627 \u0628\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062e\u062f\u0645\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u062e\u0627\u062f\u0645."}, {"id": "docs_anbar_oil_data_governance_github_pages", "label": "\u0627\u0633\u062a\u0636\u0627\u0641\u0629 \u0635\u0641\u062d\u0627\u062a \u062b\u0627\u0628\u062a\u0629 \u0639\u0644\u0649 GitHub Pages \u2014 \u0628\u0644\u0627 \u062e\u0627\u062f\u0645 \u064a\u0639\u0627\u0644\u062c \u0628\u064a\u0627\u0646\u0627\u062a", "file_type": "concept", "source_file": "docs/anbar-oil/data-governance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062b\u0627\u0628\u062a\u0629 \u062a\u064f\u0644\u063a\u064a \u0637\u0628\u0642\u0629 \u062e\u0627\u062f\u0645 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0643\u0627\u0645\u0644\u0629: \u0644\u0627 \u0645\u0639\u0627\u0644\u062c\u0629 \u0648\u0644\u0627 \u0633\u062c\u0644\u0651 \u064a\u062d\u062a\u0641\u0638 \u0628\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0641\u062a\u0646\u062d\u0635\u0631 \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u062e\u0637\u0631 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062d\u062f\u0647\u0627 \u062d\u064a\u062b \u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0633\u064a\u0627\u0633\u0627\u062a \u0627\u0644\u0635\u0641\u0651."}, {"id": "docs_anbar_oil_data_governance_access_matrix", "label": "\u0645\u0635\u0641\u0648\u0641\u0629 \u00ab\u0645\u0646 \u064a\u0631\u0649 \u0645\u0627\u0630\u0627\u00bb \u2014 \u0627\u0644\u0646\u0627\u0633\u060c \u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u062d\u0637\u0629\u060c \u0641\u0631\u0639 \u0627\u0644\u062a\u0648\u0632\u064a\u0639\u060c \u0627\u0644\u0625\u062f\u0627\u0631\u0629", "file_type": "document", "source_file": "docs/anbar-oil/data-governance.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0641\u0631\u0639 \u0627\u0644\u062a\u0648\u0632\u064a\u0639 \u064a\u0631\u0649 \u0644\u0648\u062d\u0629 \u0645\u062a\u0627\u0628\u0639\u0629 \u0648\u0623\u0639\u062f\u0627\u062f\u0627\u064b \u0645\u062c\u0645\u064e\u0651\u0639\u0629 \u0641\u0642\u0637 \u2014 \u0628\u0644\u0627 \u0647\u0627\u062a\u0641 \u0648\u0644\u0627 \u0627\u0633\u0645 \u0635\u0627\u062d\u0628 \u0645\u062d\u0637\u0629 \u0648\u0644\u0627 \u0639\u0646\u0648\u0627\u0646 \u0625\u0634\u0639\u0627\u0631\u061b \u0623\u064a \u0623\u0646 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0623\u064f\u0639\u0637\u064a\u062a \u0623\u0642\u0644\u0651 \u0645\u0627 \u064a\u0643\u0641\u064a \u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u063a\u0637\u064a\u0629 \u0644\u0627 \u0643\u0644\u0651 \u0645\u0627 \u0641\u064a \u0627\u0644\u0642\u0627\u0639\u062f\u0629."}, {"id": "docs_anbar_oil_data_governance_retention_and_deletion", "label": "\u0633\u064a\u0627\u0633\u0629