{"nodes": [{"id": "readme_muhta_pwa", "label": "\u0627\u0644\u0645\u062d\u0637\u0629 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 PWA", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tech_stack", "label": "Tech Stack (Next.js 16, Supabase, Leaflet, Web Push)", "file_type": "concept", "rationale": "Leaflet plus OpenStreetMap is chosen so the map needs no paid keys; the service worker is hand-written for offline use and notifications.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_roles", "label": "Three Roles: Driver, Station Owner, Admin", "file_type": "concept", "rationale": "Drivers browse, filter, vote and subscribe with no account at all; owners manage their station at /owner; admins approve or reject stations at /admin. A station is invisible to users until admin approval.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_database_schema", "label": "Database Schema (profiles, stations, station_products, traffic_votes, push_subscriptions, ads)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_station_traffic_avg", "label": "station_traffic_avg View", "file_type": "concept", "rationale": "Computes the 30-minute rolling congestion average at read time rather than storing it; one vote per station per device per 30 minutes, and an owner's own setting overrides the user average.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_color_only_voting", "label": "Colour-Only Congestion Voting", "file_type": "rationale", "rationale": "Votes are green/amber/red only, never free text, and this is enforced at the database level rather than only in the UI so no comment thread can ever appear.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_env_vars", "label": "Environment Variables and VAPID Keys", "file_type": "concept", "rationale": "The anon key is safe to expose because RLS protects it; the service role key is server-only and used for sending notifications.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_muhta_pwa", "target": "readme_tech_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_muhta_pwa", "target": "readme_roles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_muhta_pwa", "target": "readme_database_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_muhta_pwa", "target": "readme_env_vars", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_database_schema", "target": "readme_station_traffic_avg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_color_only_voting", "target": "readme_database_schema", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_station_traffic_avg", "targ