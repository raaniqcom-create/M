{"nodes": [{"id": "docs_anbar_oil_guide_service_guide", "label": "Service Guide (Four-Page Attachment)", "file_type": "document", "source_file": "docs/anbar-oil/guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_problem_statement", "label": "Problem Statement Table", "file_type": "concept", "rationale": "Four causes and their consequences: citizens learn availability only by asking or trying, information spreads verbally and through social groups, congestion is unevenly distributed, and calls flood the directorate and stations daily over something published information would settle.", "source_file": "docs/anbar-oil/guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_three_step_flow", "label": "Three-Step Operating Flow", "file_type": "concept", "rationale": "The station registers once, its supervisor toggles availability from an ordinary phone with no software, hardware or training, and the citizen sees the state immediately sorted by proximity with a one-tap route via Google Maps or Waze.", "source_file": "docs/anbar-oil/guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_admin_approval_gate", "label": "Admin Approval and Phone Verification Gate", "file_type": "rationale", "rationale": "No station is published without review by platform administration and a phone confirmation of its owner, so nobody can register a station that is not theirs or publish data under an existing station's name.", "source_file": "docs/anbar-oil/guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_privacy_stance", "label": "Data and Privacy Stance", "file_type": "rationale", "rationale": "No account, name or phone number is asked of a citizen to browse; no personal data is gathered and no movement tracked, with location used on the citizen's own device only to sort by proximity. What is published is station data as a service facility, all of it declared willingly by the owner.", "source_file": "docs/anbar-oil/guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_directorate_benefits", "label": "Benefits Offered to the Directorate", "file_type": "concept", "rationale": "A digital extension of the daily distribution tables, self-distributing congestion relief, fewer inbound calls, a live field picture showing which stations announced availability and when each last updated, an indicator of supply regularity per city, and no cost or financial commitment on the directorate.", "source_file": "docs/anbar-oil/guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_expansion_plan", "label": "Four-Phase Expansion Plan", "file_type": "concept", "rationale": "Phase one Ramadi (in progress), phase two Fallujah, Hit, Habbaniyah, Khalidiyah, Amiriyat al-Fallujah and Karma, phase three the remaining western cities, phase four a monitoring dashboard and periodic reports on availability regularity per city.", "source_file": "docs/anbar-oil/guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_guide_faq", "label": "Anticipated Questions Box", "file_type": "concept", "rationale": "Liability rests with the station owner who enters the data, shown with a last-updated timestamp; a per-station report button reaches administration and a repeatedly inaccurate station can be delisted; no special hardware or internet is needed; and there are no fees on stations or citizens.", "source_file": "docs/anbar-oil/guide.html", "source_location": null, 