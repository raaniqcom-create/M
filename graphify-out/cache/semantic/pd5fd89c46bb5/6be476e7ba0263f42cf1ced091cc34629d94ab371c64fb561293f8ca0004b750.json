{"nodes": [{"id": "store_google_play_listing", "label": "Google Play Store Listing Copy", "file_type": "document", "source_file": "store/google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_app_name", "label": "App Name Without the Province", "file_type": "rationale", "rationale": "The name omits \u00ab\u0627\u0644\u0623\u0646\u0628\u0627\u0631\u00bb because the name is fixed in the user's mind while expansion to the rest of Iraq cannot carry a name that confines the platform to one province; Anbar stays in the description, which can be edited any time.", "source_file": "store/google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_package_name", "label": "Package Name online.muhta.app", "file_type": "concept", "rationale": "Immutable after creation and must match the AAB file, the Firebase project and assetlinks.json.", "source_file": "store/google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_data_safety", "label": "Play Data Safety Declaration", "file_type": "concept", "rationale": "Approximate location is declared as not collected because it is used on-device only to sort stations and never sent to the server; name and phone are collected for station owners only, congestion colour votes count as user-generated content, and the notification identifier as a device ID.", "source_file": "store/google-play.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_google_play_content_rating", "label": "Play Content Rating Answers", "file_type": "concept", "rationale": "Colour voting is declared as not user interaction, so the expected rating is Everyone / 3+.", "source_file": "store/google-play.md", "source_location": null, "sourc