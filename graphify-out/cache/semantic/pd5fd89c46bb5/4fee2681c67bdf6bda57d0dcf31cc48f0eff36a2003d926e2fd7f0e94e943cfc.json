{"nodes": [{"id": "handover_muhta_platform", "label": "\u0627\u0644\u0645\u062d\u0637\u0629 \u0627\u0644\u062a\u0642\u0646\u064a\u0629 Platform Architecture", "file_type": "document", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_supabase_edge_functions", "label": "Deployed Supabase Edge Functions", "file_type": "concept", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_telegram_function", "label": "telegram Edge Function (@muhtaonlinebot)", "file_type": "concept", "rationale": "The whole bot: station registration, administration, favourites. Stateless apart from the telegram_drafts table.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_notify_function", "label": "notify Edge Function", "file_type": "concept", "rationale": "Availability alerts fan out over Telegram, FCM for Android, and APNs directly for iOS.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_otp_function", "label": "otp Edge Function (OTPIQ SMS)", "file_type": "concept", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_admin_alert_function", "label": "admin-alert Edge Function", "file_type": "concept", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_broadcast_function", "label": "broadcast Edge Function", "file_type": "concept", "rationale": "Admin-only and two-step, so a promotional blast to every subscriber cannot be sent by a single slip.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_station_phone_function", "label": "station-phone Edge Function", "file_type": "rationale", "rationale": "The phone number is both the published number and the login identity (p<digits>@muhta.app), so changing it transfers ownership; that is why it goes through a dedicated admin-only function instead of a field update.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_delete_account_function", "label": "delete-account Edge Function", "file_type": "rationale", "rationale": "Added because App Store guideline 5.1.1(v) requires in-app account deletion, and the privacy policy was documenting the violation itself.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_apns_direct", "label": "iOS Talks to APNs Directly", "file_type": "rationale", "rationale": "Routing iOS pushes through FCM would mean adding the Firebase package to Xcode, a GoogleService-Info.plist in the build, and a second vendor, for a hop Apple does not require.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_traffic_per_lane", "label": "Congestion Measured Per Lane, Not Per Station", "file_type": "rationale", "rationale": "One colour for the whole forecourt turns a driver away from an empty pump. The three lanes are gasoline_premium, gasoline_regular and kerosene.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_post_trip_traffic_prompt", "label": "Ask About Congestion Only After the Trip", "file_type": "rationale", "rationale": "Voting from the browse card asks for a judgement from someone who never went; it produced two votes in two days and was deleted. Engagement is to be re-measured after a month, and the feature dropped if it stays at zero because a permanently empty indicator teaches users that part of the app is broken.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_no_auto_dedupe", "label": "No Automatic Deletion on Station Similarity", "file_type": "rationale", "rationale": "Similarity is surfaced to the admin, who decides after a phone call, rather than being auto-resolved.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_static_export_dynamic_routes", "label": "Static Export Constraint on Dynamic Routes", "file_type": "rationale", "rationale": "Any dynamic route needs generateStaticParams under output: 'export', which is why the admin station page is /admin/station/?id= rather than [id].", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_input_font_size_16px", "label": "Inputs At Least 16px", "file_type": "rationale", "rationale": "iOS zooms the page when focusing an input smaller than 16px and never zooms back out.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_pre_review_audit", "label": "Pre-Review Multi-Agent Audit", "file_type": "concept", "rationale": "An hour before submission a multi-agent audit found four real defects, three of which would certainly have been rejected by App Review.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_apns_registration_bug", "label": "Missing APNs Device-Token Registration", "file_type": "concept", "rationale": "AppDelegate.swift was the default Capacitor template with no didRegisterForRemoteNotificationsWithDeviceToken, so the token was discarded and no row was ever written to device_tokens. Key, entitlement and sound were all correct while the first link of the chain was missing, meaning iOS notifications had never worked.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_stations_guard_trg", "label": "stations_guard_trg RLS Trigger", "file_type": "concept", "rationale": "status was unprotected in RLS, so any account owner could publish their own station instantly with status:'approved'; a database trigger now guards it.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_iphone_only_bundle", "label": "iPhone-Only Bundle", "file_type": "rationale", "rationale": "The bundle was universal with no iPad screenshots and no iPad design, so it was narrowed to iPhone only.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_dsa_trader_verification", "label": "DSA Trader Verification (EU Distribution)", "file_type": "concept", "rationale": "EU distribution requires trader-account verification from the App Information page, otherwise the app is blocked in Europe alone.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_six_real_stations", "label": "Only Six Real Stations in the Whole Province", "file_type": "concept", "rationale": "Named as the platform's weakest point, weaker than any missing feature, because both the store reviewer and the driver see it. Registration from the bot takes a station one minute.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "handover_secrets_locations", "label": "Secrets Live Outside the Repo", "file_type": "rationale", "rationale": "The repository is public, so nothing is committed: Supabase secrets are set with supabase secrets set and GitHub secrets with scripts/set-gh-secret.py.", "source_file": "HANDOVER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_android_capacitor_webview_shell", "target": "handover_muhta_platform", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "HANDOVER.md", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_deploy_static_export_to_github_pages", "target": "handover_static_export_dynamic_routes", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "HANDOVER.md", "source_location": null, "weight": 1.0}, {"source": "handover_apns_direct", "target": "_github_workflows_android_firebase_config_restore", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "HANDOVER.md", "source_location": null, "weight": 1.0}, {"source": "handover_input_font_size_16px", "target": "_github_workflows_ios_wkwebview_shell", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "HANDOVER.md", "source_location": null, "weight": 1.0}, {"source": "handover_muhta_platform", "target": "handover_supabase_edge_functions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "HANDOVER.md", "source_location": null, "weight": 1.0}, {"source": "handover_supabase_edge_functions", "target": "handover_telegram_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "HANDOVER.md", "source_locati