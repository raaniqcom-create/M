{"nodes": [{"id": "docs_anbar_oil_annex_oil_data_annex", "label": "\u0645\u0644\u062d\u0642 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u2014 \u0623\u0631\u0628\u0639\u0629 \u0645\u0644\u0627\u062d\u0642 \u0645\u0631\u0641\u0642\u0629 \u0628\u0627\u0644\u0643\u062a\u0627\u0628 \u0627\u0644\u0631\u0633\u0645\u064a", "file_type": "document", "source_file": "docs/anbar-oil/annex-oil.html", "source_location": null, "source_url": "muhta.online", "captured_at": null, "author": "\u0623\u062d\u0645\u062f \u0627\u0644\u0631\u0641\u0627\u0639\u064a", "contributor": null}, {"id": "docs_anbar_oil_annex_oil_station_coverage_map", "label": "\u0645\u0644\u062d\u0642 (\u0661) \u2014 \u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0631\u0642\u0639\u0629 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a\u0629 \u0644\u0644\u0645\u062d\u0637\u0627\u062a \u0627\u0644\u0645\u0633\u062c\u0651\u0644\u0629", "file_type": "image", "source_file": "docs/anbar-oil/annex-oil.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u062e\u0631\u064a\u0637\u0629 SVG \u0645\u0631\u0633\u0648\u0645\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u062b\u064a\u0642\u0629 (\u0644\u0627 \u0635\u0648\u0631\u0629 \u062e\u0627\u0631\u062c\u064a\u0629) \u062a\u064f\u0638\u0647\u0631 \u0663\u0667 \u0645\u062d\u0637\u0629 \u0645\u0639\u062a\u0645\u062f\u0629 \u0628\u0646\u0642\u0627\u0637 \u0645\u0644\u0648\u0651\u0646\u0629 \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0645\u062f\u0646 \u0648\u0627\u0644\u0646\u0648\u0627\u062d\u064a \u0628\u0644\u0627 \u0645\u062d\u0637\u0629\u060c \u0645\u0639 \u0634\u0628\u0643\u0629 \u0627\u0644\u0637\u0631\u0642 \u0648\u0627\u0644\u0645\u0646\u0627\u0641\u0630 \u0627\u0644\u062d\u062f\u0648\u062f\u064a\u0629 \u2014 \u0644\u062a\u062d\u0648\u064a\u0644 \u00ab\u0641\u062c\u0648\u0629 \u0627\u0644\u062a\u0633\u062c\u064a\u0644\u00bb \u0645\u0646 \u0631\u0642\u0645 \u0625\u0644\u0649 \u0641\u0631\u0627\u063a \u0645\u0631\u0626\u064a \u064a\u062f\u0639\u0645 \u0637\u0644\u0628 \u0627\u0644\u062a\u0639\u0645\u064a\u0645."}, {"id": "docs_anbar_oil_annex_oil_registration_gap", "label": "\u0627\u0644\u0641\u0631\u0627\u063a \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u063a\u064a\u0627\u0628 \u062a\u0633\u062c\u064a\u0644 \u0644\u0627 \u063a\u064a\u0627\u0628 \u0645\u062d\u0637\u0627\u062a", "file_type": "rationale", "source_file": "docs/anbar-oil/annex-oil.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u062a\u0641\u0633\u064a\u0631 \u0635\u0631\u064a\u062d \u064a\u0633\u0628\u0642 \u0627\u0639\u062a\u0631\u0627\u0636\u0627\u064b \u0645\u062a\u0648\u0642\u0651\u0639\u0627\u064b: \u0627\u0644\u0645\u0646\u0635\u0629 \u062a\u063a\u0637\u0651\u064a \u0662\u0667 \u0642\u0636\u0627\u0621\u064b \u0648\u0646\u0627\u062d\u064a\u0629 \u0648\u0627\u0644\u0645\u0633\u062c\u064e\u0651\u0644 \u0669 \u0645\u0646\u0647\u0627 \u0641\u0642\u0637\u060c \u0641\u0627\u0644\u0646\u0642\u0635 \u0641\u064a \u0627\u0644\u0627\u0646\u062e\u0631\u0627\u0637 \u0644\u0627 \u0641\u064a \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u2014 \u0648\u0647\u0648 \u0645\u0627 \u064a\u0639\u0627\u0644\u062c\u0647 \u0627\u0644\u062a\u0639\u0645\u064a\u0645 \u0627\u0644\u0645\u0637\u0644\u0648\u0628."}, {"id": "docs_anbar_oil_annex_oil_registered_stations_table", "label": "\u0645\u0644\u062d\u0642 (\u0662) \u2014 \u062c\u062f\u0648\u0644 \u0627\u0644\u0645\u062d\u0637\u0627\u062a \u0627\u0644\u0645\u0633\u062c\u0651\u0644\u0629 (37 \u0645\u062d\u0637\u0629: \u0627\u0633\u0645\u060c \u0645\u062f\u064a\u0646\u0629\u060c \u0639\u0646\u0648\u0627\u0646\u060c \u0647\u0627\u062a\u0641\u060c \u0645\u0633\u0624\u0648\u0644)", "file_type": "document", "source_file": "docs/anbar-oil/annex-oil.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_annex_oil_subscribers_by_city", "label": "\u0645\u0644\u062d\u0642 (\u0663) \u2014 \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0648\u0646 \u0641\u064a \u0643\u0644 \u0645\u062f\u064a\u0646\u0629 (\u0627\u0644\u0645\u062c\u0645\u0648\u0639 9,641)", "file_type": "document", "source_file": "docs/anbar-oil/annex-oil.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_anbar_oil_annex_oil_subscriber_double_count", "label": "\u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0623\u0642\u0644 \u0645\u0646 \u062d\u0627\u0635\u0644 \u062c\u0645\u0639 \u0627\u0644\u0645\u062f\u0646 \u2014 \u0627\u0644\u0645\u0634\u062a\u0631\u0643 \u064a\u064f\u062d\u0633\u0628 \u0641\u064a \u0643\u0644 \u0645\u062f\u064a\u0646\u0629 \u0627\u062e\u062a\u0627\u0631\u0647\u0627", "file_type": "rationale", "source_file": "docs/anbar-oil/annex-oil.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0627\u062e\u062a\u064a\u0631 \u0639\u062f\u0651 \u00ab\u0627\u0644\u0645\u0634\u062a\u0631\u0643 \u0627\u0644\u0641\u0631\u064a\u062f\u00bb \u0644\u0644\u0645\u062c\u0645\u0648\u0639 \u0648\u0639\u062f\u0651 \u00ab\u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643\u00bb \u0644\u0643\u0644 \u0645\u062f\u064a\u0646\u0629\u060c \u0648\u0623\u064f\u0639\u0644\u0646 \u0627\u0644\u0641\u0631\u0642 \u0641\u064a \u062d\u0627\u0634\u064a\u0629 \u0627\u0644\u062c\u062f\u0648\u0644 \u0628\u062f\u0644 \u062a\u0633\u0648\u064a\u0629 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0642\u0633\u0631\u0627\u064b \u2014 \u062d\u0641\u0627\u0638\u0627\u064b \u0639\u0644\u0649 \u0635\u0644\u0627\u062d\u064a\u0629 \u0643\u0644 \u0631\u0642\u0645 \u0644\u063a\u0631\u0636\u0647 (\u0627\u0644\u062a\u063a\u0637\u064a\u0629 \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u062d\u062c\u0645)."}, {"id": "docs_anbar_oil_annex_oil_growth_since_launch", "label": "\u0645\u