{"nodes": [{"id": "_github_workflows_ios_build_ios", "label": "Build iOS Workflow", "file_type": "code", "source_file": ".github/workflows/ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_wkwebview_shell", "label": "WKWebView Shell (iOS)", "file_type": "rationale", "rationale": "Same idea as the Android build: a shell around muhta.online. Apple requires macOS to compile and sign, and GitHub's macOS runners are free for public repositories, so no Mac is needed anywhere in the project.", "source_file": ".github/workflows/ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_app_store_connect_api_key_signing", "label": "App Store Connect API Key Signing", "file_type": "rationale", "rationale": "Signing uses an App Store Connect API key rather than a checked-in certificate; -allowProvisioningUpdates lets Xcode create the distribution certificate and provisioning profile on the runner, so there is no .p12 to store, rotate, or leak. The decoded key is PEM-checked because a truncated secret produces a confusing signing failure much later.", "source_file": ".github/workflows/ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_newest_xcode_selection", "label": "Newest Xcode Selection", "file_type": "rationale", "rationale": "App Store Connect rejects anything built with an older SDK and the runner image's default Xcode is not always its newest, so the job picks the highest installed rather than pinning a version that ages out of the image; an SDK older than iOS 26 fails the build early.", "source_file": ".github/workflows/ios.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ios_run_number_build_number", "label": "Run 