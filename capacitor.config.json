{
  "appId": "online.muhta.app",
  "appName": "المحطة التقنية",
  "webDir": "out",
  "server": {
    "url": "https://muhta.online",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FFFFFF"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#FFFFFF",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
