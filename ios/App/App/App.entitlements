<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push is the one thing a home-screen PWA cannot do reliably on iOS, and
	     the reason this app exists as a native shell at all. "production" is
	     correct for both TestFlight and the App Store; Xcode swaps it for
	     development builds. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- CarPlay — فئةُ الوقود. مُنح لهذا الحساب من آبل بتاريخ ٢٠٢٦-٠٩-٠٩:
	     «The entitlement for CarPlay Fueling App has been assigned to your
	     account». ولا يُمنح بطلبٍ في Xcode: آبل تُسنده إلى الحساب أوّلاً، ثمّ
	     يظهر في مِلف التزويد.

	     وبلا هذا المفتاح لا يصل مشهدُ السيارة إلى التطبيق أصلاً، ولو أُعلن
	     الدورُ في Info.plist. -->
	<key>com.apple.developer.carplay-fueling</key>
	<true/>
</dict>
</plist>
