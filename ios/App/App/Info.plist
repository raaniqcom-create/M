<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
	</array>
	<!-- Without this string iOS denies the site's geolocation call silently and
	     "أقرب محطة إليك" never works. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>يُستخدم موقعك لترتيب المحطات حسب قربها منك. لا يُرسل إلى أي جهة.</string>
	<!-- Answers App Store Connect's export-compliance question once, instead of
	     on every TestFlight build. HTTPS only, no custom cryptography. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDisplayName</key>
        <string>المحطة التقنية</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- **مطلوبةٌ لـCarPlay.** شاشةُ السيارة مشهدٌ **ثانٍ** يعمل مع مشهد
		     الهاتف في وقتٍ واحد، وهذا المفتاحُ هو الذي يسمح بمشهدين معاً —
		     ومثالُ آبل الرسميُّ في «Displaying Content in CarPlay» يضعه `true`
		     في المقطع نفسِه الذي يُعلن دورَ السيارة.

		     وله أثرٌ جانبيٌّ واحدٌ على آيباد: يصير فتحُ نافذتين ممكناً. وهو
		     مقبولٌ هنا — التطبيقُ نافذةٌ على الموقع، ونافذتان منه لا تكسران
		     شيئاً — وليس له بديلٌ يفتح السيارةَ ويُغلق الآيباد. -->
		<key>UIApplicationSupportsMultipleScenes</key>
    <true/>
    <key>UISceneConfigurations</key>
    <dict>
      <!-- **دورُ شاشة السيارة.** بلا هذا الإعلان لا يُنشئ iOS المشهدَ إطلاقاً،
           فيبقى `CarPlaySceneDelegate` مصرَّفاً لا يعمل — وهي الحالُ التي كان
           عليها الملفُّ حتى وصل الإذن.

           والاسمُ يطابق ما يبنيه `AppDelegate.configurationForConnecting`
           حرفاً بحرف («CarPlay Configuration»)، وذاك يفرّق بالدور فيُسند
           مندوبَ السيارة ولا يبني `CAPBridgeViewController` عليها. -->
      <key>CPTemplateApplicationSceneSessionRoleApplication</key>
      <array>
        <dict>
            <!-- صنفُ المشهد يُسمّى صراحةً كما في مثال آبل: بدونه لا يعرف
                 النظامُ أنّ هذا المشهدَ `CPTemplateApplicationScene`. -->
            <key>UISceneClassName</key>
            <string>CPTemplateApplicationScene</string>
            <key>UISceneConfigurationName</key>
            <string>CarPlay Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
        </dict>
      </array>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
